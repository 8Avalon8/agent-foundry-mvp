{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentSpec v0.1",
  "type": "object",
  "required": ["agent", "goal", "lifecycle", "autonomy", "inputs", "tools", "tool_policy", "human_feedback", "memory", "output", "eval"],
  "properties": {
    "agent": {
      "type": "object",
      "required": ["name", "version", "type", "description"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "type": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "goal": {"type": "object"},
    "lifecycle": {"type": "object"},
    "autonomy": {"type": "object"},
    "inputs": {"type": "object"},
    "tools": {"type": "object"},
    "tool_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["permission", "risk"],
        "properties": {
          "permission": {"enum": ["allow", "ask", "deny"]},
          "risk": {"enum": ["low", "low_to_medium", "medium", "medium_high", "high", "critical"]},
          "scope": {},
          "allowed_commands": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "human_feedback": {"type": "object"},
    "memory": {
      "type": "object",
      "required": ["update_requires_approval"],
      "properties": {
        "update_requires_approval": {"const": true}
      },
      "additionalProperties": true
    },
    "output": {"type": "object"},
    "eval": {"type": "object"}
  }
}
